{
  "name": "@onefl666/dsh-great-plan",
  "version": "0.5.0",
  "license": "MIT",
  "author": "onefl666",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "plan-mode",
    "agent",
    "web-client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/onefl666/dsh-great-plan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onefl666/dsh-great-plan.git"
  },
  "bugs": {
    "url": "https://github.com/onefl666/dsh-great-plan/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "description": "Choose the model and reasoning effort, then execute, compact-and-execute, or start fresh with a reviewed plan.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/host/*.js",
    "lib/client.js",
    "lib/client.*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
