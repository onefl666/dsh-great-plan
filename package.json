{
  "name": "@local/dsh-great-plan",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onefl666/dsh-great-plan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onefl666/dsh-great-plan.git"
  },
  "bugs": {
    "url": "https://github.com/onefl666/dsh-great-plan/issues"
  },
  "type": "module",
  "description": "Choose the model and reasoning effort, then execute, compact-and-execute, or start fresh with a reviewed plan.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "client.*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
